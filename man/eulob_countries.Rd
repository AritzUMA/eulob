\name{eulob_countries}
\alias{eulob_countries}
\title{List indexed countries}
\description{
Lists countries represented in the bundled EU-LOB catalogue.
}
\usage{
eulob_countries(data_dir = NULL)
}
\arguments{
\item{data_dir}{Reserved argument. Must be NULL when using the bundled RDS catalogue.}
}
\value{
A data frame with country codes and counts of names and entities.
}
